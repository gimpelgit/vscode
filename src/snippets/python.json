{
  "main": {
    "prefix": "main",
    "body": [
      "def ${1:main}():",
      "    ${0:pass}",
      "",
      "",
      "if __name__ == '__main__':",
      "    ${1:main}()"
    ],
    "description": "main file"
  },

  "fori": {
    "prefix": "fori",
    "body": [
      "for i in range(${1:number}):",
      "    ${0:pass}"
    ],
    "description": "repeat several times"
  },

  "forli": {
    "prefix": "forli",
    "body": [
      "for i in range(len(${1:li})):",
      "    ${0:pass}"
    ],
    "description": "to run down the list of indexes"
  }
}